---
// Wraps a code fence. Run executes the code as shown and shows what it logs underneath: in a
// worker against a region booted for the page, or with `page`, on the page itself through its
// import map, for this site's own examples of the API, which the runner refuses. A page example
// has no Stop: what a reader types there runs on the page's thread. A Python `>>>` session isn't
// editable: its results appear inside the fence, under each statement, in place of the expected
// output shown, and Reset puts the expected output back. With a JavaScript and a Python fence, a
// toggle in the bar picks the one shown, for every such example on the page, and the choice is
// remembered on <html> as data-snippets, set before paint by the head script in snippets.mjs
const { page = false } = Astro.props;
---

<div class="runnable not-content" data-runnable data-page={page ? '' : undefined}>
  <slot />
  <div class="editor"></div>
  <div class="bar">
    <button type="button" class="run">Run</button>
    <button type="button" class="stop">Stop</button>
    <button type="button" class="edit">Edit</button>
    <button type="button" class="reset">Reset</button>
    <span class="state"></span>
    <div class="toggle" role="group" aria-label="Language">
      <button type="button" data-language="javascript">JavaScript</button>
      <button type="button" data-language="python">Python</button>
    </div>
  </div>
  <pre class="output"></pre>
</div>

<script>
  import { connect } from '../runnable/run.ts';

  for (const root of document.querySelectorAll<HTMLElement>('[data-runnable]')) connect(root);
</script>

<style>
  .runnable :global(.expressive-code) {
    margin-bottom: 0;
  }

  .runnable.editing :global(.expressive-code),
  .runnable:not(.editing) .editor,
  .runnable:not(.editing):not(.ran) .reset,
  .runnable.editing .edit,
  .runnable.session .edit,
  .runnable:not(.running) .stop,
  .runnable[data-page] .stop,
  .runnable.ran :global(.ec-line.expected),
  .output:empty {
    display: none;
  }

  /* Only a runnable with both fences toggles, and it shows the chosen one */
  .runnable:not(:has(pre[data-language='js'])) .toggle,
  .runnable:not(:has(pre[data-language='py'])) .toggle,
  :global(:root:not([data-snippets='python'])) .runnable:has(pre[data-language='js']) :global(.expressive-code:has(pre[data-language='py'])),
  :global(:root[data-snippets='python']) .runnable:has(pre[data-language='py']) :global(.expressive-code:has(pre[data-language='js'])) {
    display: none;
  }

  .runnable :global(.ec-line.result) {
    color: var(--sl-color-gray-2);
    font-style: italic;
  }

  .runnable :global(.ec-line.result.stderr) {
    color: var(--sl-color-red);
  }

  .editor :global(.cm-editor) {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    font-size: var(--sl-text-code);
  }

  .editor :global(.cm-editor.cm-focused) {
    outline: none;
    border-color: var(--sl-color-gray-3);
  }

  .editor :global(.cm-scroller) {
    padding: 0.75rem 0.5rem;
    font-family: var(--__sl-font-mono);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  button {
    font: inherit;
    padding: 0.3rem 0.9rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.4rem;
    background: transparent;
    color: var(--sl-color-white);
    cursor: pointer;
  }

  button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .state {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .toggle {
    display: flex;
    margin-inline-start: auto;
  }

  .toggle button {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    border-radius: 0;
  }

  .toggle button:first-child {
    border-start-start-radius: 0.4rem;
    border-end-start-radius: 0.4rem;
  }

  .toggle button:last-child {
    border-start-end-radius: 0.4rem;
    border-end-end-radius: 0.4rem;
    border-inline-start: 0;
  }

  :global(:root:not([data-snippets='python'])) .toggle button[data-language='javascript'],
  :global(:root[data-snippets='python']) .toggle button[data-language='python'] {
    background: var(--sl-color-gray-5);
    color: var(--sl-color-white);
  }

  .output {
    margin-top: 0.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    background: var(--sl-color-gray-6);
    font-size: var(--sl-text-code);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
