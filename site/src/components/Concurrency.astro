<section class="function">
  <h2>Concurrency</h2>
  <p class="lede">
    Each password is hashed by its own invocation, in its own environment, on its own CPU core,
    so five take about as long as one.
  </p>
  <div class="actions">
    <button id="hash-one" disabled>Hash 1 password</button>
    <button id="burst" disabled>Hash 5 passwords at once</button>
  </div>
  <details>
    <summary>Show the function's code</summary>
    <pre><code id="hash-code"></code></pre>
  </details>
</section>
