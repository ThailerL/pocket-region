<section class="function">
  <h2>Concurrency</h2>
  <p class="lede">
    Each password is hashed by its own invocation, in its own environment, on its own CPU core,
    so five take about as long as one.
  </p>
  <div class="actions">
    <button id="hash-one" disabled>Hash 1 password</button>
    <button id="burst" disabled>Hash 5 passwords at once</button>
  </div>
  <details>
    <summary>Show the function's code</summary>
    <pre><code id="hash-code"></code></pre>
  </details>
</section>

<style>
  details {
    margin-top: 0.6rem;
  }

  summary {
    cursor: pointer;
    color: var(--faint);
    font-size: 0.875rem;
  }

  pre {
    margin: 0.5rem 0 0;
    padding: 0.75rem;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    font: 0.8125rem/1.5 ui-monospace, monospace;
  }

  /* On the one-screen layout the code floats above its toggle, so opening it changes no height */
  @media (min-width: 64rem) {
    details {
      position: relative;
    }

    pre {
      position: absolute;
      right: 0;
      bottom: calc(100% + 0.25rem);
      z-index: 1;
      width: max-content;
      max-width: min(44rem, 90vw);
      background: Canvas;
    }
  }
</style>
