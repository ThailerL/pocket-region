---
import Base from '../layouts/Base.astro';
import Concurrency from '../components/Concurrency.astro';
import LambdaFunction from '../components/LambdaFunction.astro';
import RecordOrder from '../components/RecordOrder.astro';
import Terminal from '../components/Terminal.astro';
import { importMap } from '../import-map.mjs';
import '../styles/demo.css';
---

<Base
  title="Pocket Region demo"
  description="Real S3, SQS, DynamoDB, and Lambda running in your browser tab, driven from an aws terminal. No server answers it."
>
  <script type="importmap" is:inline slot="head" set:html={JSON.stringify(importMap)} />

  <h1>Pocket Region demo</h1>
  <p class="lede">
    Real S3, SQS, DynamoDB, and Lambda, running in this tab. No server answers the terminal.
  </p>

  <div class="layout">
    <Terminal />
    <div class="panel">
      <div class="tabs" role="tablist" aria-label="Demo sections">
        <button role="tab" data-tab="lambda" aria-controls="lambda-tab">Lambda</button>
        <button role="tab" data-tab="services" aria-controls="services-tab">S3, SQS, DynamoDB, SNS</button>
      </div>
      <div class="examples" id="status"></div>
      <div id="lambda-tab" role="tabpanel">
        <LambdaFunction />
        <RecordOrder />
        <Concurrency />
      </div>
      <div id="services-tab" role="tabpanel" hidden>
        <div id="examples"></div>
      </div>
    </div>
  </div>
</Base>

<script>
  import '../demo/main.ts';
</script>

<style>
  .layout {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.25rem;
  }

  /* The terminal beside the tabbed panel, which scrolls so the page stays one screen */
  @media (min-width: 64rem) {
    .layout {
      flex: 1;
      min-height: 0;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }

    .panel {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    [role='tabpanel'] {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
    }
  }
</style>
