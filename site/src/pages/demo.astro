---
import Base from '../layouts/Base.astro';
import Concurrency from '../components/Concurrency.astro';
import LambdaFunction from '../components/LambdaFunction.astro';
import Terminal from '../components/Terminal.astro';
import { importMap } from '../import-map.mjs';
import '../styles/demo.css';
---

<Base title="Pocket Region demo">
  <script type="importmap" is:inline slot="head" set:html={JSON.stringify(importMap)} />

  <h1>Pocket Region demo</h1>
  <p class="lede">
    Real S3, SQS, DynamoDB, and Lambda, running in this tab. No server answers the terminal.
  </p>

  <div class="layout">
    <div class="top">
      <Terminal />
      <div>
        <div id="examples"></div>
        <div class="examples" id="status"></div>
      </div>
    </div>

    <div class="controls">
      <LambdaFunction />
      <Concurrency />
    </div>
  </div>
</Base>

<script>
  import '../demo/main.ts';
</script>

<style>
  .layout {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.25rem;
  }

  .top {
    display: grid;
    gap: 1.5rem;
  }

  .controls > :global(* + *) {
    margin-top: 1.25rem;
  }

  /* The terminal beside its example commands, the two Lambda sections below: the top row takes
     whatever height the sections leave */
  @media (min-width: 64rem) {
    .layout {
      flex: 1;
      min-height: 0;
      /* Never shorter than the example commands, so they need no scroll bar of their own */
      grid-template-rows: minmax(auto, 1fr) auto;
    }

    .top {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }

    .controls {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
      align-items: start;
    }

    .controls > :global(* + *) {
      margin-top: 0;
    }
  }
</style>
