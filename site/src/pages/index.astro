---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';

const example = `import { clientConfig, createRegion } from 'pocket-region/browser';

const region = await createRegion();
const s3 = new S3Client(clientConfig(region));
await s3.send(new PutObjectCommand({ Bucket: 'photos', Key: 'cat.txt', Body: 'meow' }));`;

const narrowExample = `import {
  clientConfig,
  createRegion,
} from 'pocket-region/browser';

const region = await createRegion();
const s3 = new S3Client(clientConfig(region));
await s3.send(new PutObjectCommand({
  Bucket: 'photos',
  Key: 'cat.txt',
  Body: 'meow',
}));`;

const codeThemes = { light: 'github-light', dark: 'github-dark' } as const;

const features = [
  {
    title: 'In a browser tab',
    body: 'A whole region runs in a page, in a Web Worker, with no backend behind it. The page loads it from jsDelivr, and a first visit downloads about 10.5 MB.',
  },
  {
    title: 'Run buttons for your docs',
    body: 'Put a Run button on the AWS examples in your own docs. <a href="/docs/runner/"><code>createRunner</code></a> runs code written for real AWS, JavaScript or Python, against a region in the reader’s tab.',
  },
  {
    title: 'The <code>aws</code> CLI in your page',
    body: 'Run <code>aws</code> commands against a region and render the output in your page. Commands copied from AWS’s documentation run unchanged.',
  },
  {
    title: 'In your Node tests',
    body: 'The region lives in your test process and keeps real state, with no container to start. It boots in about half a second and resets to empty in about a millisecond, so every test starts clean.',
  },
  {
    title: 'Lambda',
    body: 'Create functions from a zip and invoke them. Handlers run in child processes or Web Workers, with their timeouts and reserved concurrency, and their own SDK calls reach the region.',
  },
  {
    title: 'Built on MiniStack',
    body: 'The AWS APIs come from <a href="https://ministack.org/">MiniStack</a>, a Python AWS emulator running here under Pyodide. It answers for many more services, and <a href="/docs/services/">the docs list which ones run here</a>.',
  },
];
---

<Base
  title="Pocket Region: AWS services in the browser or Node"
  description="AWS services like S3, DynamoDB, and Lambda inside a browser tab or Node, reached with the ordinary AWS SDK."
>
  <main>
    <header class="hero">
      <h1>Pocket Region</h1>
      <p class="tagline">
        AWS services like S3, DynamoDB, and Lambda inside a browser tab or your Node process, called with the
        ordinary AWS SDK. No container and no server.
      </p>
      <div class="actions">
        <a class="button primary" href="/demo">Try it in this tab</a>
        <a class="button" href="/docs/">Read the docs</a>
      </div>
    </header>

    <section>
      <Code class="wide" code={example} lang="js" themes={codeThemes} />
      <Code class="narrow" code={narrowExample} lang="js" themes={codeThemes} />
    </section>

    <section class="features">
      {
        features.map(({ title, body }) => (
          <div>
            <h2 set:html={title} />
            <p set:html={body} />
          </div>
        ))
      }
    </section>

    <footer>
      <a href="https://github.com/ThailerL/pocket-region">GitHub</a>
      <a href="https://www.npmjs.com/package/pocket-region">npm</a>
      <span>MIT licensed</span>
    </footer>
  </main>
</Base>

<style>
  .hero {
    padding: 1.5rem 0 1.25rem;
  }

  .hero h1 {
    font-size: 2.5rem;
  }

  .tagline {
    max-width: 40rem;
    font-size: 1.25rem;
    color: var(--faint);
    margin: 0.5rem 0 1.5rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .button {
    padding: 0.5rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    color: inherit;
    text-decoration: none;
  }

  .button.primary {
    background: var(--accent-fill);
    color: var(--on-accent-fill);
    border-color: var(--accent-fill);
  }

  section :global(.astro-code) {
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    font-size: 0.875rem;
  }

  /* The wide snippet's 90-character lines fit from 52em. Below that, the 41-character copy scales its font to fit */
  section :global(.wide) {
    display: none;
  }

  section :global(.narrow) {
    padding: 0.75rem;
    font-size: clamp(0.75rem, (100vw - 4rem) / 25, 0.875rem);
  }

  @media (min-width: 52em) {
    section :global(.wide) {
      display: block;
    }

    section :global(.narrow) {
      display: none;
    }
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) section :global(.astro-code),
    :global(:root:not([data-theme='light'])) section :global(.astro-code span) {
      color: var(--shiki-dark) !important;
      background-color: var(--shiki-dark-bg) !important;
    }
  }

  :global([data-theme='dark']) section :global(.astro-code),
  :global([data-theme='dark']) section :global(.astro-code span) {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1.5rem 2rem;
    margin: 2.5rem 0;
  }

  h2 {
    font-size: 1.05rem;
    margin: 0 0 0.25rem;
  }

  .features p {
    margin: 0;
    color: var(--faint);
  }

  .features :global(code) {
    font-family: ui-monospace, monospace;
    font-size: 0.9em;
  }

  footer {
    display: flex;
    gap: 1.25rem;
    margin-top: 3rem;
    color: var(--faint);
    font-size: 0.875rem;
  }

  footer a {
    color: inherit;
  }
</style>
