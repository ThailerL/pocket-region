{
  "name": "pocket-region",
  "version": "0.3.0",
  "description": "Real S3, SQS, DynamoDB, and Lambda inside Node or a browser tab, reached with the ordinary AWS SDK",
  "keywords": [
    "aws",
    "localstack",
    "s3",
    "sqs",
    "dynamodb",
    "lambda",
    "emulator",
    "testing",
    "browser",
    "pyodide",
    "aws-sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThailerL/pocket-region.git"
  },
  "homepage": "https://pocket-region.dev",
  "bugs": "https://github.com/ThailerL/pocket-region/issues",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./sdk": {
      "types": "./dist/request-handler.d.ts",
      "default": "./dist/request-handler.js"
    }
  },
  "files": [
    "dist",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "npm run vendor && npm run build",
    "embed": "node scripts/embed-python.mjs && node scripts/embed-runtime.mjs",
    "build": "npm run embed && node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "npm run embed && tsc",
    "pretest": "npm run vendor",
    "test": "npm run embed && vitest run",
    "vendor": "node scripts/vendor.mjs",
    "demo": "node scripts/serve-demo.mjs"
  },
  "dependencies": {
    "pyodide": "314.0.6"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1131.0",
    "@aws-sdk/client-lambda": "^3.1131.0",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/client-sns": "^3.1131.0",
    "@aws-sdk/client-sqs": "^3.1131.0",
    "@types/node": "^24.13.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
