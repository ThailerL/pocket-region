{
  "name": "pocket-region",
  "version": "0.8.0",
  "description": "AWS services like S3, DynamoDB, and Lambda inside Node or a browser tab, reached with the ordinary AWS SDK",
  "keywords": [
    "aws",
    "localstack",
    "s3",
    "sqs",
    "dynamodb",
    "lambda",
    "emulator",
    "testing",
    "browser",
    "pyodide",
    "aws-sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThailerL/pocket-region.git"
  },
  "homepage": "https://pocket-region.dev",
  "bugs": "https://github.com/ThailerL/pocket-region/issues",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./node": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.20"
  },
  "scripts": {
    "prepack": "npm run vendor && npm run build",
    "embed": "node scripts/embed-python.mjs && node scripts/embed-runtime.mjs && node scripts/embed-version.mjs && node scripts/embed-sucrase.mjs",
    "build": "npm run embed && node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "npm run embed && tsc",
    "pretest": "npm run vendor",
    "test": "npm run embed && vitest run",
    "vendor": "node scripts/vendor.mjs",
    "site": "npm run build && npm --prefix site run dev --"
  },
  "dependencies": {
    "pyodide": "314.0.6"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1131.0",
    "@aws-sdk/client-dynamodb": "^3.1131.0",
    "@aws-sdk/client-eventbridge": "^3.1131.0",
    "@aws-sdk/client-kinesis": "^3.1131.0",
    "@aws-sdk/client-kms": "^3.1131.0",
    "@aws-sdk/client-lambda": "^3.1131.0",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/client-secrets-manager": "^3.1131.0",
    "@aws-sdk/client-sns": "^3.1131.0",
    "@aws-sdk/client-sqs": "^3.1131.0",
    "@aws-sdk/client-ssm": "^3.1131.0",
    "@types/node": "^24.13.4",
    "@vitest/browser-playwright": "^5.0.0",
    "fflate": "^0.8.3",
    "playwright": "^1.63.0",
    "rolldown": "^1.2.8",
    "sucrase": "^3.35.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}